        "jsCode": "const resp = $input.first().json;\nconst v = $('Validate & Normalize').first().json;\nconst intents = ['demo_request', 'quote_request', 'partnership', 'support', 'spam', 'other'];\nconst urgencies = ['low', 'medium', 'high'];\n\nlet parsed = null;\ntry {\n  parsed = JSON.parse(resp && resp.choices && resp.choices[0] && resp.choices[0].message ? resp.choices[0].message.content : null);\n} catch (e) {\n  parsed = null;\n}\n\nconst ok = !!parsed\n  && typeof parsed.intent === 'string' && intents.includes(parsed.intent)\n  && typeof parsed.icp_fit === 'number' && parsed.icp_fit >= 0 && parsed.icp_fit <= 1\n  && typeof parsed.urgency === 'string' && urgencies.includes(parsed.urgency)\n  && typeof parsed.summary === 'string';\n\nlet fallback = false;\nif (!ok) {\n  fallback = true;\n  parsed = {\n    intent: 'other',\n    icp_fit: 0,\n    urgency: 'medium',\n    summary: String(v.message || v.company || '').slice(0, 140)\n  };\n}\n\nconst threshold = Number($env.LEADFLOW_ICP_FIT_THRESHOLD || 0.6);\nreturn [{\n  json: {\n    intent: parsed.intent,\n    icp_fit: parsed.icp_fit,\n    urgency: parsed.urgency,\n    summary: parsed.summary,\n    fallback,\n    create_deal: parsed.icp_fit >= threshold\n  }\n}];"
