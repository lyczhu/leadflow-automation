        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const crypto = require('crypto');\nconst canonical = (v) => {\n  if (Array.isArray(v)) return '[' + v.map(canonical).join(',') + ']';\n  if (v && typeof v === 'object') {\n    return '{' + Object.keys(v).sort().map((k) => JSON.stringify(k) + ':' + canonical(v[k])).join(',') + '}';\n  }\n  return JSON.stringify(v === undefined ? null : v);\n};\nconst sha256 = (s) => crypto.createHash('sha256').update(String(s), 'utf8').digest('hex');\nconst maskEmail = (s) => String(s || '').replace(/^([^@])[^@]*@/, '$1***@');\nconst maskPhone = (s) => String(s || '').replace(/^(\\+\\d)\\d+(\\d{2})$/, '$1***$2');\nconst maskText = (s) => String(s ?? '')\n  .replace(/([A-Za-z0-9._%+-])[A-Za-z0-9._%+-]*@([A-Za-z0-9.-]+\\.[A-Za-z]{2,})/g, '$1***@$2')\n  .replace(/(\\+\\d)[\\d\\s\\-().]*?(\\d{2})\\b/g, '$1***$2');\n\nconst input = $input.first().json;\nconst body = input.body && typeof input.body === 'object' ? input.body : {};\nconst headers = input.headers || {};\n\nconst reasons = [];\nconst warnings = [];\nconst secretEnv = $env.WEBHOOK_SHARED_SECRET || '';\nconst secret = headers['x-webhook-secret'] || '';\nif (secretEnv && secret !== secretEnv) reasons.push('bad_secret');\n\nconst form_id = String(body.form_id ?? '').trim();\nconst name = String(body.name ?? '').trim();\nconst companyRaw = String(body.company ?? '').trim();\nconst emailRaw = String(body.email ?? '').trim();\nconst message = String(body.message ?? '');\nconst phoneRaw = String(body.phone ?? '').trim();\n\nif (!form_id) reasons.push('missing_field:form_id');\nif (!name) reasons.push('missing_field:name');\nif (!companyRaw) reasons.push('missing_field:company');\n\nlet email = '';\nif (!emailRaw) reasons.push('missing_field:email');\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(emailRaw)) reasons.push('invalid_email');\nelse email = emailRaw.toLowerCase();\n\nconst SUFFIX = /(?:[\\s,.]+)(?:inc|llc|ltd|co|corp|corporation|company|plc|gmbh|ag|bv|s\\.a\\.?|a\\.s\\.|srl|s\\.r\\.l\\.|oy|ab|as|nv|sa)\\.?\\s*$/i;\nconst company = companyRaw.replace(SUFFIX, '').trim();\n\nlet phone = null;\nif (phoneRaw) {\n  let digits = phoneRaw.replace(/\\D/g, '');\n  if (!phoneRaw.startsWith('+') && digits.length === 10) digits = '1' + digits;\n  if (digits.length >= 8 && digits.length <= 15) phone = '+' + digits;\n  else warnings.push('phone_not_e164');\n}\n\nconst idempotency_key = sha256(email + '|' + form_id);\nconst payload_hash = sha256(canonical(body));\nconst run_id = crypto.randomUUID();\nconst nameParts = name.split(/\\s+/).filter(Boolean);\n\nreturn [{\n  json: {\n    valid: reasons.length === 0,\n    reject_reason: reasons[0] || null,\n    run_id,\n    received_at: new Date().toISOString(),\n    start_ts: Date.now(),\n    payload_hash,\n    idempotency_key,\n    form_id,\n    name,\n    first_name: nameParts[0] || '',\n    last_name: nameParts.slice(1).join(' '),\n    email,\n    email_masked: maskEmail(email),\n    phone,\n    phone_masked: phone ? maskPhone(phone) : '',\n    company,\n    message,\n    message_masked: maskText(message),\n    payload_masked: {\n      form_id,\n      name,\n      company,\n      message: maskText(message),\n      email: maskEmail(email),\n      phone: phone ? maskPhone(phone) : ''\n    },\n    warnings\n  }\n}];"
      },
