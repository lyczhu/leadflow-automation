{
  "name": "02-error-handler",
  "nodes": [
    {
      "parameters": {},
      "id": "22222222-2222-4222-8222-222222222201",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [-220, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first().json;\nconst err = (j.execution && j.execution.error) || {};\nconst raw = String(err.message || '');\nconst maskText = (s) => String(s ?? '')\n  .replace(/([A-Za-z0-9._%+-])[A-Za-z0-9._%+-]*@([A-Za-z0-9.-]+\\.[A-Za-z]{2,})/g, '$1***@$2')\n  .replace(/(\\+\\d)[\\d\\s\\-().]*?(\\d{2})\\b/g, '$1***$2');\n\nlet parsed = null;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = null;\n}\nconst detail = parsed && parsed.run_id ? parsed : null;\nconst run_id = (detail && detail.run_id) || '';\nconst payload_hash = (detail && detail.payload_hash) || '';\nconst latency_ms = detail && detail.latency_ms !== undefined && detail.latency_ms !== null ? Number(detail.latency_ms) : '';\nconst reason = (detail && detail.code) || 'unhandled_error';\nconst payload = detail && detail.payload_masked ? JSON.stringify(detail.payload_masked) : '';\n\nreturn [{\n  json: {\n    workflow: (j.workflow && j.workflow.name) || '',\n    execution_id: (j.execution && j.execution.id) || '',\n    execution_url: (j.execution && j.execution.url) || '',\n    node: (err.node && err.node.name) || '',\n    reason,\n    error_message: maskText(raw).slice(0, 1200),\n    run_id,\n    payload_hash,\n    latency_ms,\n    payload_masked: maskText(payload),\n    received_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "22222222-2222-4222-8222-222222222202",
      "name": "Compose Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [40, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "authentication": "serviceAccount",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.LEADFLOW_AUDIT_SHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "audit"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_id": "={{ $json.run_id || $json.execution_id }}",
            "received_at": "={{ $json.received_at }}",
            "payload_hash": "={{ $json.payload_hash }}",
            "outcome": "failed",
            "model_output": "",
            "fallback": false,
            "latency_ms": "={{ $json.latency_ms }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "run_id", "displayName": "run_id", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "removed": false, "type": "string" },
            { "id": "received_at", "displayName": "received_at", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "removed": false, "type": "string" },
            { "id": "payload_hash", "displayName": "payload_hash", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "removed": false, "type": "string" },
            { "id": "outcome", "displayName": "outcome", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "removed": false, "type": "string" },
            { "id": "model_output", "displayName": "model_output", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "removed": false, "type": "string" },
            { "id": "fallback", "displayName": "fallback", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "removed": false, "type": "string" },
            { "id": "latency_ms", "displayName": "latency_ms", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "removed": false, "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "22222222-2222-4222-8222-222222222203",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "name": "Audit Failed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [280, 0],
      "onError": "continueRegularOutput",
      "credentials": {
        "googleApi": {
          "name": "leadflow-google-sheets"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ ($env.LEADFLOW_SLACK_ALERT_CHANNEL || 'ops-alerts').replace(/^#/, '') }}"
        },
        "text": "=Leadflow execution failed | reason: {{ $json.reason }} | workflow: {{ $json.workflow }} | node: {{ $json.node || 'n/a' }} | run_id: {{ $json.run_id || 'n/a' }} | execution: {{ $json.execution_url }} | payload: {{ $json.payload_masked || 'n/a' }} | error: {{ $json.error_message }}",
        "otherOptions": {}
      },
      "id": "22222222-2222-4222-8222-222222222204",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "name": "Alert Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [520, 0],
      "onError": "continueRegularOutput",
      "credentials": {
        "slackApi": {
          "name": "leadflow-slack"
        }
      }
    }
  ],
