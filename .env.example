# Copy to .env and fill in real values. .env is git-ignored.

# --- n8n / postgres ---------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n

# Pin the n8n image tag. Never use "latest": a restart must not change behavior.
# Check the release you tested and record it here.
N8N_VERSION=

# Generate once, keep it stable: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Shanghai

# --- workflow credentials ----------------------------------------------------
# Create these in the n8n credential store (the workflows reference them by
# name only): leadflow-openai, leadflow-hubspot, leadflow-slack,
# leadflow-google-sheets. See reference/setup.md.

# --- leadflow runtime values (read inside n8n via $env.*) --------------------
LEADFLOW_ICP_FIT_THRESHOLD=0.6
LEADFLOW_OPENAI_MODEL=
LEADFLOW_AUDIT_SHEET_ID=
LEADFLOW_SLACK_ALERT_CHANNEL=#ops-alerts
LEADFLOW_SLACK_NOTIFY_CHANNEL=#leads
WEBHOOK_SHARED_SECRET=

# --- local tooling only (never read by the workflow) -------------------------
# N8N_API_KEY=          # n8n UI -> Settings -> n8n API; scopes: workflows r/w, credentials read
# HUBSPOT_TOKEN=        # used only by scripts/acceptance.ps1
