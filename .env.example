# Copy to .env and fill in real values. .env is git-ignored.

# --- n8n / postgres ---------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n

# Pin the n8n image tag. Never use "latest": a restart must not change behavior.
# Check the release you tested and record it here.
N8N_VERSION=

# Generate once, keep it stable: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Shanghai

# --- workflow credentials (set these inside n8n's credential store) ---------
# OPENAI_API_KEY=sk-...
# HUBSPOT_PRIVATE_APP_TOKEN=pat-...
# SLACK_BOT_TOKEN=xoxb-...
# AUDIT_SHEET_ID=
# WEBHOOK_SHARED_SECRET=
